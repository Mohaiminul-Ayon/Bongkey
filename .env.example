# Copy this file to .env in the project root:
# E:\Eyewear-mvp\.env
#
# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
# Shop WhatsApp number for chat links, e.g. 8801XXXXXXXXX (a local 01XXXXXXXXX also works). Set it in frontend/.env.local.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Backend
APP_ENV=development
# Browser origin(s) of the shop frontend allowed to call the API, comma-separated, exact match.
FRONTEND_ORIGIN=http://localhost:3000
SERVER_PORT=8080
DATABASE_URL=postgres://bongkey:bongkey_password@localhost:5432/bongkey?sslmode=disable
# Set these only to create the first owner account; existing credentials are never reset at startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set a unique random secret of at least 32 characters before starting the backend.
JWT_SECRET=
# Optional Gmail sender for email OTP. Use a dedicated account with 2-Step Verification.
# Keep the Google app password only in your local .env; never commit or share it.
GMAIL_FROM=
GMAIL_APP_PASSWORD=
# Local testing only: @example.test addresses get this code and no email is sent. Leave unset normally.
# EMAIL_TEST_CODE=123456

# PostgreSQL
POSTGRES_DB=bongkey
POSTGRES_USER=bongkey
POSTGRES_PASSWORD=bongkey_password
POSTGRES_PORT=5432
